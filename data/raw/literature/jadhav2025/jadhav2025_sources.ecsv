# %ECSV 1.0
# ---
# datatype:
# - name: GaiaDR3
#   datatype: int64
#   description: Gaia DR3 source_id (GaiaDR3)
#   meta: !!omap
#   - {ucd: ID_MAIN}
#   - {width: 19}
# - name: Cluster
#   datatype: string
#   description: Cluster name (cluster)
#   meta: !!omap
#   - {ucd: ID_PARENT}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: 13*}
# - name: Ref
#   datatype: string
#   description: Reference of the source catalogue (reference) (G1)
#   meta: !!omap
#   - {ucd: REFER_CODE}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: 16*}
# - name: ClusterID
#   datatype: int16
#   description: Unique Cluster ID (cluster_id)
#   meta: !!omap
#   - {ucd: ID_NUMBER}
#   - {width: 3}
# - name: Grade
#   datatype: string
#   description: '[GSB] Grade of the catalogue (G=gold, S=silver, B=bronze) (grade)'
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {_votable_string_dtype: char}
# - name: Class
#   datatype: string
#   description: '[CLT] Membership (C=cluster, L=leading tail, T=trailing tail) (class)'
#   meta: !!omap
#   - {ucd: CODE_MEMB}
#   - {_votable_string_dtype: char}
# - name: RA_ICRS
#   unit: deg
#   datatype: float64
#   format: '{:10.6f}'
#   description: '[0.01/359.99] Right ascension (ICRS) at Ep=2016 (RAdeg)'
#   meta: !!omap
#   - {ucd: POS_EQ_RA_MAIN}
#   - {width: 10}
#   - {precision: '6'}
# - name: DE_ICRS
#   unit: deg
#   datatype: float64
#   format: '{:10.6f}'
#   description: '[-88.67/82.08] Declination (ICRS) at Ep=2016 (DEdeg)'
#   meta: !!omap
#   - {ucd: POS_EQ_DEC_MAIN}
#   - {width: 10}
#   - {precision: '6'}
# - name: rmedgeo
#   unit: pc
#   datatype: float64
#   format: '{:9.4f}'
#   description: '[8.08/1259.71] Geometric distance (Bailer-Jones et al., 2021, Cat. I/352) (r_med_geo)'
#   meta: !!omap
#   - {ucd: PHYS_DISTANCE_TRUE}
#   - {width: 9}
#   - {precision: '4'}
# - name: pmRA
#   unit: mas / yr
#   datatype: float64
#   format: '{:9.4f}'
#   description: '[-154.4/772.18] Proper motion in R.A. direction (pmRA*cosDE, Gaia) (pmRA)'
#   meta: !!omap
#   - {ucd: POS_EQ_PMRA}
#   - {width: 9}
#   - {precision: '4'}
# - name: pmDE
#   unit: mas / yr
#   datatype: float64
#   format: '{:9.4f}'
#   description: '[-217.21/458.25] Proper motion in Dec. direction (Gaia) (pmDE)'
#   meta: !!omap
#   - {ucd: POS_EQ_PMDEC}
#   - {width: 9}
#   - {precision: '4'}
# - name: RV
#   unit: km / s
#   datatype: float64
#   format: '{:9.4f}'
#   description: '[-276.82/770.13]? Radial velocity (Gaia) (RV)'
#   meta: !!omap
#   - {ucd: VELOC_HC}
#   - {width: 9}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - name: Gmag
#   unit: mag
#   datatype: float32
#   format: '{:7.4f}'
#   description: '[2.68/20.79] Gaia DR3 G band magnitude (Gaia) (Gmag)'
#   meta: !!omap
#   - {ucd: PHOT_MAG_OPTICAL}
#   - {width: 7}
#   - {precision: '4'}
# - name: BPmag
#   unit: mag
#   datatype: float64
#   format: '{:8.4f}'
#   description: '[3.15/22.35]? Gaia DR3 BP band magnitude (Gaia) (BPmag)'
#   meta: !!omap
#   - {ucd: PHOT_MAG_B}
#   - {width: 8}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - name: RPmag
#   unit: mag
#   datatype: float64
#   format: '{:8.4f}'
#   description: '[2.57/20.01]? Gaia DR3 RP band magnitude (Gaia) (RPmag)'
#   meta: !!omap
#   - {ucd: PHOT_MAG_R}
#   - {width: 8}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - name: BP-RP
#   unit: mag
#   datatype: float32
#   format: '{:7.4f}'
#   description: '[-0.42/4.95]? Gaia DR3 BP-RP colour (Gaia) (BP_RP)'
#   meta: !!omap
#   - {ucd: PHOT_CI_B-R}
#   - {width: 7}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - name: GMAG
#   unit: mag
#   datatype: float64
#   format: '{:8.4f}'
#   description: '[-4.15/20.26] Absolute G band magnitude (Gaia) (GaMAG)'
#   meta: !!omap
#   - {ucd: PHOT_ABS-MAG_BAND}
#   - {width: 8}
#   - {precision: '4'}
# - name: r3d
#   unit: pc
#   datatype: float32
#   format: '{:6.2f}'
#   description: '[0.07/904.38] Cartesian distance from the cluster centre (r_3d)'
#   meta: !!omap
#   - {ucd: PHYS_DISTANCE_TRUE}
#   - {width: 6}
#   - {precision: '2'}
# - name: v3d
#   unit: km / s
#   datatype: float32
#   format: '{:7.2f}'
#   description: '[0.03/767.96]? Cartesian speed relative to the cluster centre (v_3d)'
#   meta: !!omap
#   - {ucd: VELOC_MISC}
#   - {width: 7}
#   - {precision: '2'}
#   - values: {'null': .nan}
# - name: rsky
#   unit: deg
#   datatype: float32
#   format: '{:7.4f}'
#   description: '[0.0/57.3] Distance from the cluster centre projected on the sky (r_sky)'
#   meta: !!omap
#   - {ucd: POS_ANG_DIST_GENERAL}
#   - {width: 7}
#   - {precision: '4'}
# - name: pmR
#   unit: mas / yr
#   datatype: float64
#   format: '{:10.4f}'
#   description: '[-123.12/1729.76] Radial component of the projected proper motion from the cluster centre (pm_R)'
#   meta: !!omap
#   - {ucd: POS_PM_NON-EQ}
#   - {width: 10}
#   - {precision: '4'}
# - name: e_pmR
#   unit: mas / yr
#   datatype: float32
#   format: '{:7.4f}'
#   description: Error in pm_R (e_pm_R)
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 7}
#   - {precision: '4'}
# - name: pmT
#   unit: mas / yr
#   datatype: float64
#   format: '{:9.4f}'
#   description: '[-501.33/490.82] Tangential component of the projected proper motion from the cluster centre (pm_T)'
#   meta: !!omap
#   - {ucd: POS_PM_NON-EQ}
#   - {width: 9}
#   - {precision: '4'}
# - name: e_pmT
#   unit: mas / yr
#   datatype: float32
#   format: '{:7.4f}'
#   description: Error in pm_T (e_pm_T)
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 7}
#   - {precision: '4'}
# - name: deltaRVGC
#   unit: km / s
#   datatype: float64
#   format: '{:9.4f}'
#   description: '[-240.36/637.97]? Relative radial velocity in the Galactic plane as seen from the Galactic centre (delta_v_r_GC)'
#   meta: !!omap
#   - {ucd: VELOC_GC}
#   - {width: 9}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - name: deltaphiGC
#   unit: deg
#   datatype: float32
#   format: '{:7.4f}'
#   description: '[-3.85/3.49] Relative azimuth. Angle created by the Sun-GC-star on the Galactic plane (delta_phi_GC)'
#   meta: !!omap
#   - {ucd: POS_INCLIN_GP}
#   - {width: 7}
#   - {precision: '4'}
# - name: distFromO
#   unit: pc
#   datatype: float32
#   format: '{:6.2f}'
#   description: '[0.05/904.08] Distance between the star and the clusters Galactic orbit (distance_from_orbit)'
#   meta: !!omap
#   - {ucd: PHYS_DISTANCE_TRUE}
#   - {width: 6}
#   - {precision: '2'}
# - name: distAlongO
#   unit: pc
#   datatype: float32
#   format: '{:7.2f}'
#   description: '[-493.73/546.63] Distance between the centre and the point closest to the star on the Galactic orbit (distance_along_orbit)'
#   meta: !!omap
#   - {ucd: PHYS_DISTANCE_TRUE}
#   - {width: 7}
#   - {precision: '2'}
# - name: cmdDist
#   unit: mag
#   datatype: float32
#   format: '{:7.4f}'
#   description: '? Distance from the region defined by the RLs of q=0 and q=1 in the CMD (cmd_distance)'
#   meta: !!omap
#   - {ucd: PHOT_DIST-MOD}
#   - {width: 7}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - name: q
