# %ECSV 1.0
# ---
# datatype:
# - name: Cluster
#   datatype: string
#   description: Common name of the cluster (Cluster)
#   meta: !!omap
#   - {ucd: ID_PARENT}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: 17*}
# - name: GaiaDR3
#   datatype: int64
#   description: Gaia DR3 source_id (source_id)
#   meta: !!omap
#   - {ucd: ID_MAIN}
#   - {width: 19}
# - name: RA_ICRS
#   unit: deg
#   datatype: float64
#   format: '{:15.11f}'
#   description: Gaia DR3 Right ascension (ICRS) at Ep=2016.0 (ra_icrs)
#   meta: !!omap
#   - {ucd: POS_EQ_RA_MAIN}
#   - {width: 15}
#   - {precision: '11'}
# - name: DE_ICRS
#   unit: deg
#   datatype: float64
#   format: '{:15.11f}'
#   description: Gaia DR3 Declination (ICRS) at Ep=2016.0 (dec_icrs)
#   meta: !!omap
#   - {ucd: POS_EQ_DEC_MAIN}
#   - {width: 15}
#   - {precision: '11'}
# - name: pmRA
#   unit: mas / yr
#   datatype: float64
#   format: '{:22.15g}'
#   description: Gaia DR3 proper motion in R.A.,pmRA*cosDE (pmra)
#   meta: !!omap
#   - {ucd: POS_EQ_PMRA}
#   - {width: 22}
#   - {precision: E15}
# - name: pmDE
#   unit: mas / yr
#   datatype: float64
#   format: '{:22.15g}'
#   description: Gaia DR3 proper motion in declination (pmdec)
#   meta: !!omap
#   - {ucd: POS_EQ_PMDEC}
#   - {width: 22}
#   - {precision: E15}
# - name: plx
#   unit: mas
#   datatype: float64
#   format: '{:20.17f}'
#   description: Gaia DR3 parallax (parallax)
#   meta: !!omap
#   - {ucd: POS_PARLX_TRIG}
#   - {width: 20}
#   - {precision: '17'}
# - name: RV
#   unit: km / s
#   datatype: float64
#   format: '{:22.15g}'
#   description: '? Gaia DR3 radial velocity (radial_velocity)'
#   meta: !!omap
#   - {ucd: VELOC_HC}
#   - {width: 22}
#   - {precision: E15}
#   - values: {'null': .nan}
# - name: X
#   unit: kpc
#   datatype: float64
#   format: '{:20.16f}'
#   description: Galactocentric X coordinate of the star (Sun is at X=-8.122) (x)
#   meta: !!omap
#   - {ucd: POS_GAL_X}
#   - {width: 20}
#   - {precision: '16'}
# - name: Y
#   unit: kpc
#   datatype: float64
#   format: '{:22.15g}'
#   description: Galactocentric Y coordinate of the star (Sun is at Y=0.0) (y)
#   meta: !!omap
#   - {ucd: POS_GAL_Y}
#   - {width: 22}
#   - {precision: E15}
# - name: Z
#   unit: kpc
#   datatype: float64
#   format: '{:22.15g}'
#   description: Galactocentric Z coordinate of the star (Sun is at Z=0.0208) (z)
#   meta: !!omap
#   - {ucd: POS_GAL_Z}
#   - {width: 22}
#   - {precision: E15}
# - name: daxis
#   unit: kpc
#   datatype: float64
#   format: '{:22.15g}'
#   description: Position along the dominant axis of the cluster (d_axis)
#   meta: !!omap
#   - {ucd: PHYS_SIZE_MAJ}
#   - {width: 22}
#   - {precision: E15}
# - name: GLON
#   unit: deg
#   datatype: float64
#   format: '{:22.15g}'
#   description: Galactic longitude (l)
#   meta: !!omap
#   - {ucd: POS_GAL_LON}
#   - {width: 22}
#   - {precision: E15}
# - name: GLAT
#   unit: deg
#   datatype: float64
#   format: '{:22.15g}'
#   description: Galactic latitude (b)
#   meta: !!omap
#   - {ucd: POS_GAL_LAT}
#   - {width: 22}
#   - {precision: E15}
# - name: d2d
#   unit: deg
#   datatype: float64
#   format: '{:22.15g}'
#   description: Distance from the cluster centre projected on the sky (d_2d)
#   meta: !!omap
#   - {ucd: POS_ANG_DIST_GENERAL}
#   - {width: 22}
#   - {precision: E15}
# - name: proj2d
#   unit: mas / yr
#   datatype: float64
#   format: '{:22.15g}'
#   description: On-sky motion projected to the radial direction from the cluster centre (proj_2d)
#   meta: !!omap
#   - {ucd: PHYS_DISTANCE_PROJ}
#   - {width: 22}
#   - {precision: E15}
# - name: projPerp2d
#   unit: mas / yr
#   datatype: float64
#   format: '{:22.15g}'
#   description: On-sky motion projected perpendicularly to the radial direction from the cluster centre (proj_perp_2d)
#   meta: !!omap
#   - {ucd: PHYS_DISTANCE_PROJ}
#   - {width: 22}
#   - {precision: E15}
# - name: d3d
#   unit: kpc
#   datatype: float64
#   format: '{:22.15g}'
#   description: Distance from the cluster centre (d_3d)
#   meta: !!omap
#   - {ucd: PHYS_DISTANCE_TRUE}
#   - {width: 22}
#   - {precision: E15}
# - name: proj3d
#   unit: km / s
#   datatype: float64
#   format: '{:22.15g}'
#   description: '? Motion projected to the radial direction from the cluster centre (proj_3d)'
#   meta: !!omap
#   - {ucd: PHYS_DISTANCE_PROJ}
#   - {width: 22}
#   - {precision: E15}
#   - values: {'null': .nan}
# - name: projPerp3d
#   unit: km / s
#   datatype: float64
#   format: '{:22.18f}'
#   description: '? Motion projected perpendicularly to the radial direction from the cluster centre (proj_perp_3d)'
#   meta: !!omap
#   - {ucd: PHYS_DISTANCE_PROJ}
#   - {width: 22}
#   - {precision: '18'}
#   - values: {'null': .nan}
# - name: like
#   datatype: float64
#   format: '{:25.18f}'
#   description: Likelihood for the star to be a member of the cluster (likelihood)
#   meta: !!omap
#   - {ucd: STAT_LIKELIHOOD}
#   - {width: 25}
#   - {precision: '18'}
# - name: like6d
#   datatype: float64
#   format: '{:22.15g}'
#   description: Likelihood for the star to be a member of the cluster calculated from a six dimensional parameter space (likelihood_6d)
#   meta: !!omap
#   - {ucd: STAT_LIKELIHOOD}
#   - {width: 22}
#   - {precision: E15}
# - name: pbint
#   datatype: float64
#   format: '{:22.15g}'
#   description: '[0/1] Membership probability calculated with the "integrated" method (probability_int)'
#   meta: !!omap
#   - {ucd: CODE_MEMB}
#   - {width: 22}
#   - {precision: E15}
# - name: pbbin
#   datatype: float64
#   format: '{:22.15g}'
#   description: '[0/1] Membership probability calculated with the "bin" method (probability_bin)'
#   meta: !!omap
#   - {ucd: CODE_MEMB}
#   - {width: 22}
#   - {precision: E15}
# - name: Gmag
#   datatype: float64
#   format: '{:19.16f}'
#   description: Gaia DR3 mean G magnitude (phot_g_mean_mag)
#   meta: !!omap
#   - {ucd: PHOT_MAG_OPTICAL}
#   - {width: 19}
#   - {precision: '16'}
# - name: BPmag
#   datatype: float64
#   format: '{:19.16f}'
#   description: Gaia DR3 mean BP magnitude (phot_bp_mean_mag)
#   meta: !!omap
#   - {ucd: PHOT_MAG_B}
#   - {width: 19}
#   - {precision: '16'}
# - name: RPmag
#   datatype: float64
#   format: '{:19.16f}'
#   description: Gaia DR3 mean RP magnitude (phot_rp_mean_mag)
#   meta: !!omap
#   - {ucd: PHOT_MAG_R}
#   - {width: 19}
#   - {precision: '16'}
# - name: AG
#   unit: mag
#   datatype: float64
#   format: '{:22.15g}'
#   description: Gaia DR3 extinction in G band (ag_gspphot)
#   meta: !!omap
#   - {ucd: PHOT_EXTINCTION_ISM}
#   - {width: 22}
#   - {precision: E15}
# - name: E(BP-RP)
#   unit: mag
#   datatype: float64
#   format: '{:22.15g}'
#   description: Gaia DR3 colour excess E(BP-RP) (ebpminrp_gspphot)
#   meta: !!omap
#   - {ucd: PHOT_COLOR_EXCESS}
#   - {width: 22}
#   - {precision: E15}
# - name: RUWE
#   datatype: float64
#   format: '{:20.17f}'
#   description: Gaia DR3 RUWE index (ruwe)
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 20}
#   - {precision: '17'}
# - name: Mass
#   unit: solMass
#   datatype: float64
#   format: '{:20.17f}'
#   description: Stellar mass (mass)
#   meta: !!omap
#   - {ucd: PHYS_MASS_MISC}
#   - {width: 20}
#   - {precision: '17'}
# - name: _RA.icrs
