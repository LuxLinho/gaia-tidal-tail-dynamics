# %ECSV 1.0
# ---
# datatype:
# - name: Cluster
#   datatype: string
#   description: Name of the cluster
#   meta: !!omap
#   - {ucd: ID_PARENT}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: 13*}
# - name: GaiaDR3
#   datatype: int64
#   description: Gaia DR3 source_id
#   meta: !!omap
#   - {ucd: ID_MAIN}
#   - {width: 19}
# - name: RA_ICRS
#   unit: deg
#   datatype: float64
#   format: '{:10.6f}'
#   description: Right ascension (ICRS) at Ep=2016
#   meta: !!omap
#   - {ucd: POS_EQ_RA_MAIN}
#   - {width: 10}
#   - {precision: '6'}
# - name: DE_ICRS
#   unit: deg
#   datatype: float64
#   format: '{:10.6f}'
#   description: Declination (ICRS) at Ep=2016
#   meta: !!omap
#   - {ucd: POS_EQ_DEC_MAIN}
#   - {width: 10}
#   - {precision: '6'}
# - name: plx
#   unit: mas
#   datatype: float64
#   format: '{:10.6f}'
#   description: Absolute stellar parallax
#   meta: !!omap
#   - {ucd: POS_PARLX_TRIG}
#   - {width: 10}
#   - {precision: '6'}
# - name: pmRA
#   unit: mas / yr
#   datatype: float64
#   format: '{:11.6f}'
#   description: Proper motion in right ascension
#   meta: !!omap
#   - {ucd: POS_EQ_PMRA}
#   - {width: 11}
#   - {precision: '6'}
# - name: pmDE
#   unit: mas / yr
#   datatype: float64
#   format: '{:11.6f}'
#   description: Proper motion in declination
#   meta: !!omap
#   - {ucd: POS_EQ_PMDEC}
#   - {width: 11}
#   - {precision: '6'}
# - name: BP-RP
#   unit: mag
#   datatype: float32
#   format: '{:6.3f}'
#   description: Gaia DR3 BP minus RP colour
#   meta: !!omap
#   - {ucd: PHOT_CI_B-R}
#   - {width: 6}
#   - {precision: '3'}
# - name: Gmag
#   unit: mag
#   datatype: float32
#   format: '{:6.3f}'
#   description: Gaia DR3 mean G magnitude
#   meta: !!omap
#   - {ucd: PHOT_MAG_OPTICAL}
#   - {width: 6}
#   - {precision: '3'}
# - name: GMAG
#   unit: mag
#   datatype: float32
#   format: '{:6.3f}'
#   description: Absolute G magnitude
#   meta: !!omap
#   - {ucd: PHOT_ABS-MAG_BAND}
#   - {width: 6}
#   - {precision: '3'}
# - name: X
#   unit: pc
#   datatype: float32
#   format: '{:7.2f}'
#   description: Solar system barycentric cartesian X coordinate
#   meta: !!omap
#   - {ucd: POS_GAL_X}
#   - {width: 7}
#   - {precision: '2'}
# - name: Y
#   unit: pc
#   datatype: float32
#   format: '{:7.2f}'
#   description: Solar system barycentric cartesian Y coordinate
#   meta: !!omap
#   - {ucd: POS_GAL_Y}
#   - {width: 7}
#   - {precision: '2'}
# - name: Z
#   unit: pc
#   datatype: float32
#   format: '{:7.2f}'
#   description: Solar system barycentric cartesian Z coordinate
#   meta: !!omap
#   - {ucd: POS_GAL_Z}
#   - {width: 7}
#   - {precision: '2'}
# - name: Delvpll
#   unit: km / s
#   datatype: float32
#   format: '{:6.2f}'
#   description: Velocity parallel to the convergent point (Del_v_parallel)
#   meta: !!omap
#   - {ucd: VELOC_MISC}
#   - {width: 6}
#   - {precision: '2'}
# - name: vperobs
#   unit: km / s
#   datatype: float32
#   format: '{:5.2f}'
#   description: Velocity perpendicular to the convergent point (v_perpendicular_obs)
#   meta: !!omap
#   - {ucd: VELOC_MISC}
#   - {width: 5}
#   - {precision: '2'}
# - name: pmRAc
#   unit: mas / yr
#   datatype: float64
#   format: '{:12.6f}'
#   description: Proper motion in right ascension corrected for solar reflex motion
#   meta: !!omap
#   - {ucd: POS_EQ_PMRA}
#   - {width: 12}
#   - {precision: '6'}
# - name: pmDEc
#   unit: mas / yr
#   datatype: float64
#   format: '{:11.6f}'
#   description: Proper motion in declination corrected for solar reflex motion
#   meta: !!omap
#   - {ucd: POS_EQ_PMDEC}
#   - {width: 11}
#   - {precision: '6'}
# - name: phi1
#   unit: deg
#   datatype: float64
#   format: '{:11.6f}'
#   description: Tail aligned longitude
#   meta: !!omap
#   - {ucd: POS_FRAME_LON}
#   - {width: 11}
#   - {precision: '6'}
# - name: phi2
#   unit: deg
#   datatype: float64
#   format: '{:10.6f}'
#   description: Tail aligned latitude
#   meta: !!omap
#   - {ucd: POS_FRAME_LAT}
#   - {width: 10}
#   - {precision: '6'}
# - name: pmphi1cosphi2
#   unit: mas / yr
#   datatype: float64
#   format: '{:12.6f}'
#   description: Proper motion in phi1, pmph1*cosphi2
#   meta: !!omap
#   - {ucd: POS_PM_NON-EQ}
#   - {width: 12}
#   - {precision: '6'}
# - name: pmphi2
#   unit: mas / yr
#   datatype: float64
#   format: '{:11.6f}'
#   description: Proper motion in phi2
#   meta: !!omap
#   - {ucd: POS_PM_NON-EQ}
#   - {width: 11}
#   - {precision: '6'}
# - name: 5DNeighcount
#   datatype: int16
#   description: Number of neighbors in 5 dimensions
#   meta: !!omap
#   - {ucd: NUMBER}
#   - {width: 4}
# - name: FleadingTail
#   datatype: uint8
#   description: '[0/1] Flag indicating the star in leading tail'
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {width: 1}
# - name: FtrailingTail
#   datatype: uint8
#   description: '[0/1] Flag indicating the star in trailing tail'
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {width: 1}
# - name: FwithinTidRad
#   datatype: uint8
#   description: '[0/1] Flag indicating the star in within the tidal radius'
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {width: 1}
# - name: FCorrSamp
#   datatype: uint8
#   description: '[0/1] Flag indicating the star is a part of corrected sample'
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {width: 1}
# - name: Method
#   datatype: string
#   description: Method used
#   meta: !!omap
#   - {ucd: REDUCT_METHOD}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: 8*}
# - name: RV
#   unit: km / s
#   datatype: float64
#   format: '{:23.18f}'
#   description: '? Radial Velocity'
#   meta: !!omap
#   - {ucd: VELOC_HC}
#   - {width: 23}
#   - {precision: '18'}
#   - values: {'null': .nan}
# - name: Lz
#   unit: km kpc / s
#   datatype: float32
#   format: '{:7.2f}'
#   description: '? Z-component of orbital angular momentum of star'
#   meta: !!omap
#   - {ucd: PHYS_ANG-MOMENTUM}
#   - {width: 7}
#   - {precision: '2'}
#   - values: {'null': .nan}
# - name: Energy
#   unit: 100000 km2 / s2
#   datatype: float64
#   format: '{:10.2f}'
#   description: '? Total orbital Energy of star'
#   meta: !!omap
#   - {ucd: ORBIT_PARAM}
#   - {width: 10}
#   - {precision: '2'}
#   - values: {'null': .nan}
# - name: Simbad
#   datatype: string
#   description: Simbad column added by the CDS
#   meta: !!omap
#   - {ucd: DATA_LINK}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: 6*}
# - name: _RA.icrs
#   unit: deg
#   datatype: float64
#   format: '{:10.6f}'
#   description: Right ascension (ICRS) at Epoch=J2000, proper motions taken into account
#   meta: !!omap
#   - {ucd: POS_EQ_RA_OTHER}
#   - {width: 10}
#   - {precision: '6'}
# - name: _DE.icrs
#   unit: deg
#   datatype: float64
#   format: '{:10.6f}'
#   description: Declination (ICRS) at Epoch=J2000, proper motions taken into account
#   meta: !!omap
#   - {ucd: POS_EQ_DEC_OTHER}
#   - {width: 10}
#   - {precision: '6'}
# meta: !!omap
# - {ID: J_A_A_694_A258_members}
# - {name: J/A+A/694/A258/members}
# - {description: Tidal tails of open star clusters within 400pc from the Sun}
# schema: astropy-2.0
